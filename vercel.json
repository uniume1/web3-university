{
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "apps/web/dist"
      }
    }
  ],
  "outputDirectory": "apps/web/dist",
  "buildCommand": "pnpm run build --filter=web --filter=server --filter=!contracts",
  "installCommand": "pnpm install"
}
