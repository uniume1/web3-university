{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"web": {
			"root": "apps/web",
			"framework": "vite"
		},
		"api": {
			"root": "apps/server",
			"entrypoint": "src/index.ts",
			"framework": "hono"
		}
	},
	"rewrites": [
		{
			"source": "/api",
			"destination": {
				"service": "api"
			}
		},
		{
			"source": "/api/(.*)",
			"destination": {
				"service": "api"
			}
		},
		{
			"source": "/(.*)",
			"destination": {
				"service": "web"
			}
		}
	]
}
